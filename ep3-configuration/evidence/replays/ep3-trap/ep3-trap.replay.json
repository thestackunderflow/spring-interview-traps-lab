{
  "schema": "logreplay.annot.v1",
  "id": "traps3-trap",
  "run": "run.jsonl",
  "format": "spring-boot",
  "title": "app log · trap version · real run",
  "show": [
    "thread",
    "logger"
  ],
  "elidePaths": true,
  "probes": [
    "^LAB: "
  ],
  "folds": [
    {
      "from": "start",
      "to": "banner-end",
      "label": "Spring Boot banner"
    },
    {
      "from": {
        "seq": 10
      },
      "to": {
        "seq": 11
      },
      "label": "app starts (trap version)"
    },
    {
      "from": {
        "seq": 12
      },
      "to": {
        "seq": 34
      },
      "label": "Spring creates its own beans"
    },
    {
      "from": {
        "seq": 40
      },
      "to": {
        "seq": 81
      },
      "label": "the rest of startup"
    }
  ],
  "segments": [
    {
      "until": "end",
      "mode": "step",
      "dwellMs": 450
    }
  ],
  "events": [
    {
      "id": "create",
      "at": {
        "match": "Creating shared instance of singleton bean 'auditLog'"
      },
      "tag": "Spring creates the auditLog bean",
      "kind": "live"
    },
    {
      "id": "built1",
      "at": {
        "match": "^LAB: AuditLog constructor ran, #1$"
      },
      "tag": "Constructor run #1",
      "kind": "live"
    },
    {
      "id": "order",
      "at": {
        "match": "Creating shared instance of singleton bean 'orderService'"
      },
      "tag": "Spring creates orderService",
      "kind": "live"
    },
    {
      "id": "built2",
      "at": {
        "match": "^LAB: AuditLog constructor ran, #2$"
      },
      "tag": "Run #2: Spring never logged it",
      "kind": "live",
      "predictMs": 2500
    },
    {
      "id": "same",
      "at": {
        "match": "^LAB: same object\\? false$"
      },
      "tag": "Same object? false: two AuditLogs",
      "kind": "live"
    }
  ]
}